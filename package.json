{
  "name": "@aid-on/fractop",
  "version": "0.6.6",
  "type": "module",
  "description": "FractoP - Fractal Processor for infinite-length text processing with LLMs",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aid-On/fractop.git"
  },
  "bugs": {
    "url": "https://github.com/Aid-On/fractop/issues"
  },
  "homepage": "https://github.com/Aid-On/fractop#readme",
  "author": "Aid-On Team",
  "scripts": {
    "build": "tsup",
    "build:tsc": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark": "npm run build && node bench/run.mjs"
  },
  "keywords": [
    "llm",
    "fractal",
    "chunking",
    "long-context",
    "text-processing",
    "ai",
    "medical-grade",
    "reliability"
  ],
  "license": "MIT",
  "dependencies": {
    "@aid-on/nagare": "^0.2.5",
    "@aid-on/unillm": "^0.5.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.12",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "vite@5.4.21": "^6.4.3",
    "esbuild@0.21.5": "~0.25.0",
    "tinypool@0.8.4": "^2.1.2",
    "tinypool@1.1.1": "^2.1.2",
    "@vitest/mocker@3.2.7": "^4.1.11"
  }
}
